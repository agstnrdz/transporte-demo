# Artefactos de build (los generan tools/build-pages.mjs y tools/build-datos.mjs)
_site/
node_modules/

# Productos de build-datos.mjs: se regeneran en cada deploy.
# Las fuentes versionadas son los data/linea-*.geojson y data/paradas.geojson.
data/recorridos.geojson
data/paradas.json

# Tablas de frecuencias: las planillas quedan sólo en la computadora de quien las
# mantiene. Se versionan los .json que genera tools/build-frecuencias.mjs, que son lo
# que publica el sitio.
data/frecuencias/*.csv
data/frecuencias/*.xls
data/frecuencias/*.xlsx
data/frecuencias/*.ods
data/frecuencias/~$*

# Descartes pendientes de borrar por el usuario
data/_a_borrar/

# Trabajo de QGIS: el .gpkg es el master de edición, no se versiona.
# Lo que se versiona son los data/linea-*.geojson exportados desde él.
*.gpkg
*.gpkg-shm
*.gpkg-wal
*.qgz
*.qgs
*.qgs~
*.qgd
*.qmd
*.aux.xml
*.cpg
.qgis/

# Sistema
.DS_Store
Thumbs.db
desktop.ini
